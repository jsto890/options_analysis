{
    "openapi": "3.1.0",
    "info": {
      "title": "QQQ 0DTE Ladder Backend",
      "version": "1.0.0"
    },
    "servers": [
      {
        "url": "http://127.0.0.1:8000"
      }
    ],
    "paths": {
      "/health": {
        "get": {
          "summary": "Health check",
          "responses": {
            "200": {
              "description": "Health response",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HealthResponse"
                  }
                }
              }
            }
          }
        }
      },
      "/state": {
        "get": {
          "summary": "Full state snapshot for debugging",
          "responses": {
            "200": {
              "description": "State snapshot",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/StateSnapshot"
                  }
                }
              }
            }
          }
        }
      },
      "/config": {
        "post": {
          "summary": "Update runtime config and persist locally",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigUpdate"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Updated config",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Config"
                  }
                }
              }
            },
            "422": {
              "description": "Validation error"
            }
          }
        }
      },
      "/stream": {
        "get": {
          "summary": "WebSocket endpoint for live stream",
          "description": "This is a WebSocket endpoint. OpenAPI documents it for discovery only. See websocket_schema.json for message schemas.",
          "responses": {
            "101": {
              "description": "Switching Protocols"
            }
          }
        }
      }
    },
    "components": {
      "schemas": {
        "HealthResponse": {
          "type": "object",
          "required": [
            "ok",
            "server_ts_ms",
            "ibkr_connected",
            "subscriptions"
          ],
          "properties": {
            "ok": { "type": "boolean" },
            "server_ts_ms": { "type": "integer" },
            "ibkr_connected": { "type": "boolean" },
            "subscriptions": { "type": "integer" }
          }
        },
        "UnderlyingSpot": {
          "type": "object",
          "required": [
            "bid",
            "ask",
            "last",
            "mid",
            "ts_ms"
          ],
          "properties": {
            "bid": { "type": ["number", "null"] },
            "ask": { "type": ["number", "null"] },
            "last": { "type": ["number", "null"] },
            "mid": { "type": ["number", "null"] },
            "ts_ms": { "type": "integer" }
          }
        },
        "PerDollarGreeks": {
          "type": "object",
          "required": [
            "gamma_per_dollar",
            "vega_per_dollar",
            "theta_per_dollar"
          ],
          "properties": {
            "gamma_per_dollar": { "type": ["number", "null"] },
            "vega_per_dollar": { "type": ["number", "null"] },
            "theta_per_dollar": { "type": ["number", "null"] }
          }
        },
        "MtcRationale": {
          "type": "object",
          "required": [
            "liquidity_score",
            "cheap_iv_score",
            "efficiency_score",
            "stability_score",
            "tradable_score",
            "gate_liquid",
            "gate_delta_band",
            "notes"
          ],
          "properties": {
            "liquidity_score": { "type": "number" },
            "cheap_iv_score": { "type": "number" },
            "efficiency_score": { "type": "number" },
            "stability_score": { "type": "number" },
            "tradable_score": { "type": "number" },
            "gate_liquid": { "type": "boolean" },
            "gate_delta_band": { "type": "boolean" },
            "notes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "ContractBlock": {
          "type": "object",
          "required": [
            "contract_id",
            "mid",
            "iv",
            "iv_residual",
            "delta",
            "gamma",
            "vega",
            "theta",
            "spread_pct",
            "volume",
            "oi",
            "liquid",
            "stale_ms",
            "per_dollar",
            "mtc_score",
            "mtc_rationale"
          ],
          "properties": {
            "contract_id": { "type": "string" },
            "mid": { "type": ["number", "null"] },
            "iv": { "type": ["number", "null"] },
            "iv_residual": { "type": ["number", "null"] },
            "delta": { "type": ["number", "null"] },
            "gamma": { "type": ["number", "null"] },
            "vega": { "type": ["number", "null"] },
            "theta": { "type": ["number", "null"] },
            "spread_pct": { "type": ["number", "null"] },
            "volume": { "type": ["integer", "null"] },
            "oi": { "type": ["integer", "null"] },
            "liquid": { "type": "boolean" },
            "stale_ms": { "type": "integer" },
            "per_dollar": { "$ref": "#/components/schemas/PerDollarGreeks" },
            "mtc_score": { "type": ["number", "null"] },
            "mtc_rationale": { "oneOf": [ { "$ref": "#/components/schemas/MtcRationale" }, { "type": "null" } ] }
          }
        },
        "StrikeExposures": {
          "type": "object",
          "required": [
            "oi",
            "vol"
          ],
          "properties": {
            "oi": {
              "type": "object",
              "required": ["dex", "gex", "vex"],
              "properties": {
                "dex": { "type": ["number", "null"] },
                "gex": { "type": ["number", "null"] },
                "vex": { "type": ["number", "null"] }
              }
            },
            "vol": {
              "type": "object",
              "required": ["dex", "gex", "vex"],
              "properties": {
                "dex": { "type": ["number", "null"] },
                "gex": { "type": ["number", "null"] },
                "vex": { "type": ["number", "null"] }
              }
            }
          }
        },
        "RowFlags": {
          "type": "object",
          "required": [
            "is_msi",
            "wall_type"
          ],
          "properties": {
            "is_msi": { "type": "boolean" },
            "wall_type": { "type": "string", "enum": ["none", "call_wall", "put_wall"] }
          }
        },
        "StrikeRow": {
          "type": "object",
          "required": [
            "strike",
            "msi_score",
            "flags",
            "call",
            "put",
            "exposures"
          ],
          "properties": {
            "strike": { "type": "number" },
            "msi_score": { "type": ["number", "null"] },
            "flags": { "$ref": "#/components/schemas/RowFlags" },
            "call": { "$ref": "#/components/schemas/ContractBlock" },
            "put": { "$ref": "#/components/schemas/ContractBlock" },
            "exposures": { "$ref": "#/components/schemas/StrikeExposures" }
          }
        },
        "Summary": {
          "type": "object",
          "required": [
            "net_gex_band",
            "pin_risk",
            "msi_strikes",
            "mtc_call_contract_id",
            "mtc_put_contract_id",
            "nearest_msi_distance_pct"
          ],
          "properties": {
            "net_gex_band": { "type": ["number", "null"] },
            "pin_risk": { "type": "number" },
            "msi_strikes": { "type": "array", "items": { "type": "number" } },
            "mtc_call_contract_id": { "type": ["string", "null"] },
            "mtc_put_contract_id": { "type": ["string", "null"] },
            "nearest_msi_distance_pct": { "type": ["number", "null"] }
          }
        },
        "Config": {
          "type": "object",
          "required": [
            "update_interval_ms",
            "window_strikes_each_side",
            "roll_threshold_strikes",
            "max_spread_pct",
            "min_bid_size",
            "min_ask_size",
            "max_stale_ms",
            "min_fit_points",
            "delta_band_min",
            "delta_band_max",
            "msi_bandwidth_pct",
            "gex_band_pct",
            "persistence_updates",
            "persistence_fraction",
            "iv_residual_scale",
            "iv_imbalance_threshold",
            "min_mid_for_extremes",
            "max_subscriptions_soft_limit"
          ],
          "properties": {
            "update_interval_ms": { "type": "integer" },
            "window_strikes_each_side": { "type": "integer" },
            "roll_threshold_strikes": { "type": "integer" },
            "max_spread_pct": { "type": "number" },
            "min_bid_size": { "type": "integer" },
            "min_ask_size": { "type": "integer" },
            "max_stale_ms": { "type": "integer" },
            "min_fit_points": { "type": "integer" },
            "delta_band_min": { "type": "number" },
            "delta_band_max": { "type": "number" },
            "msi_bandwidth_pct": { "type": "number" },
            "gex_band_pct": { "type": "number" },
            "persistence_updates": { "type": "integer" },
            "persistence_fraction": { "type": "number" },
            "iv_residual_scale": { "type": "number" },
            "iv_imbalance_threshold": { "type": "number" },
            "min_mid_for_extremes": { "type": "number" },
            "max_subscriptions_soft_limit": { "type": "integer" }
          }
        },
        "ConfigUpdate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "update_interval_ms": { "type": "integer" },
            "window_strikes_each_side": { "type": "integer" },
            "roll_threshold_strikes": { "type": "integer" },
            "max_spread_pct": { "type": "number" },
            "min_bid_size": { "type": "integer" },
            "min_ask_size": { "type": "integer" },
            "max_stale_ms": { "type": "integer" },
            "min_fit_points": { "type": "integer" },
            "delta_band_min": { "type": "number" },
            "delta_band_max": { "type": "number" },
            "msi_bandwidth_pct": { "type": "number" },
            "gex_band_pct": { "type": "number" },
            "persistence_updates": { "type": "integer" },
            "persistence_fraction": { "type": "number" },
            "iv_residual_scale": { "type": "number" },
            "iv_imbalance_threshold": { "type": "number" },
            "min_mid_for_extremes": { "type": "number" },
            "max_subscriptions_soft_limit": { "type": "integer" }
          }
        },
        "StateSnapshot": {
          "type": "object",
          "required": [
            "underlying",
            "config",
            "summary",
            "rows"
          ],
          "properties": {
            "underlying": {
              "type": "object",
              "required": ["symbol", "expiry", "spot"],
              "properties": {
                "symbol": { "type": "string" },
                "expiry": { "type": "string" },
                "spot": { "$ref": "#/components/schemas/UnderlyingSpot" }
              }
            },
            "config": { "$ref": "#/components/schemas/Config" },
            "summary": { "$ref": "#/components/schemas/Summary" },
            "rows": { "type": "array", "items": { "$ref": "#/components/schemas/StrikeRow" } }
          }
        }
      }
    }
  }
